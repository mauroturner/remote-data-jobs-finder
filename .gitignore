# ---- Personal data: never commit ----
# Your real profile and filters (only config.example.yaml is versioned)
config.yaml
config.*.yaml
!config.example.yaml
*.local.yaml
.env
.env.*

# Generated reports (job lists derived from your profile)
output/
*.csv

# Your resume and its generated Markdown (only the folder's README is versioned)
your-resume/*
!your-resume/README.md

# CVs and personal documents anywhere else
*.pdf
*.doc
*.docx
cv/
resume/

# ---- Local agent tooling caches ----
.atl/

# ---- Python ----
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
